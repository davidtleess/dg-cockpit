{
  "model": "claude-fable-5[1m]",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": true,
    "dg-pm@dynasty-genius": true
  },
  "extraKnownMarketplaces": {
    "dynasty-genius": {
      "source": {
        "source": "directory",
        "path": "/Users/davidleess/dynasty-genius-product/tools/dg-pm-plugin"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Claude needs your input\"' | tr -d '\"\\\\' | { read -r m; osascript -e \"display notification \\\"$m\\\" with title \\\"Claude — $(basename \\\"$PWD\\\")\\\"\"; } 2>/dev/null || true",
            "async": true,
            "statusMessage": "Posting notification"
          }
        ]
      }
    ]
  }
}
